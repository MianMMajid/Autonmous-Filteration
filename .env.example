# Copy to .env and fill in. Never commit .env.
# Node loads this automatically via --env-file-if-exists in the pnpm scripts.

# SiteLedger portal (https://pulley-siteledger.vercel.app/)
SITELEDGER_BASE_URL=https://pulley-siteledger.vercel.app
SITELEDGER_USERNAME=
SITELEDGER_PASSWORD=

# Simulated Pulley API
PULLEY_BASE_URL=https://pulley-siteledger.vercel.app
PULLEY_API_KEY=

# Optional
# Unset paths use the project root. Explicit relative paths use the shell working directory.
# Use absolute paths for scheduled deployment.
# LOG_LEVEL=warn          # trace|debug|info|warn|error; the summary prints regardless
# DATA_DIR=./data         # where raw downloads and outputs are written
# RETAIN_RUNS=60          # past runs to keep under data/raw and data/out
# OVERRIDES_FILE=./overrides.csv   # human decisions; keep it in version control
